<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:padding="28dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Configuração" android:textSize="26sp" android:textStyle="bold"/>
    <EditText android:id="@+id/periodField" android:layout_width="220dp" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:hint="Período (minutos)" android:inputType="number"
        android:gravity="center" android:textSize="22sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Tempo de cada estado: verde e vermelho" android:textSize="14sp"/>
    <Button android:id="@+id/saveButton" android:layout_width="180dp" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:text="guardar" android:textAllCaps="false"/>
    <Button android:id="@+id/cancelButton" android:layout_width="180dp" android:layout_height="wrap_content"
        android:text="cancelar" android:textAllCaps="false"/>
</LinearLayout>
